# ARAG Environment Configuration
# Copy this file to .env and fill in your values
# 复制本文件为 .env 后填入真实密钥；.env 已被 .gitignore 忽略

# ==============================================================================
# 主包 src/arag 的 LLM 设置（OpenAI 兼容端点）
# ==============================================================================
ARAG_API_KEY=your-api-key-here
ARAG_BASE_URL=https://api.openai.com/v1
ARAG_MODEL=gpt-4o-mini

# ==============================================================================
# api_client 全局开关
# ==============================================================================
# 是否打印每次请求的状态行（true/false）
API_CLIENT_VERBOSE=true

# ==============================================================================
# SiliconFlow —— 向量 + 重排（两个接口共用一个 Key）
# ==============================================================================
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 单次 embedding 请求携带的文本条数，超出自动切分并发
SILICONFLOW_EMBED_BATCH_SIZE=32
# 单次 rerank 请求携带的文档数，超出自动分片后按分数全局归并
SILICONFLOW_RERANK_BATCH_SIZE=64
# 单条文本字符上限（bge-m3 上限 8192 token）
SILICONFLOW_MAX_CHARS=8000
SILICONFLOW_TIMEOUT=60
SILICONFLOW_MAX_RETRIES=3
SILICONFLOW_MAX_WORKERS=4

# ==============================================================================
# 通义千问（DashScope）—— 项目唯一主 LLM
# ==============================================================================
QWEN_API_KEY=sk-your-dashscope-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# 长文本场景使用的模型
QWEN_LONG_MODEL=qwen-long
QWEN_TEMPERATURE=0.0
# 0 或留空表示不限制输出长度
QWEN_MAX_TOKENS=0
QWEN_TIMEOUT=120
QWEN_MAX_RETRIES=3
QWEN_MAX_WORKERS=4

# ==============================================================================
# Moonshot Kimi —— 仅预留通道，主流水线不调用
# ==============================================================================
# ak- 开头的 api_id 仅作控制台标识，不参与 HTTP 鉴权
MOONSHOT_API_ID=ak-your-moonshot-api-id
MOONSHOT_API_KEY=sk-your-moonshot-key
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-32k
MOONSHOT_TEMPERATURE=0.0
MOONSHOT_TIMEOUT=120
MOONSHOT_MAX_RETRIES=3

# ==============================================================================
# 文心一言（百度千帆 V2）—— 服务降级备用
# ==============================================================================
WENXIN_API_KEY=bce-v3/ALTAK-your-qianfan-key
# 可选，千帆应用 ID，会作为 appid 请求头发送
WENXIN_APP_ID=
WENXIN_BASE_URL=https://qianfan.baidubce.com/v2
WENXIN_MODEL=ernie-4.5-turbo-128k
WENXIN_TEMPERATURE=0.0
WENXIN_TIMEOUT=120
WENXIN_MAX_RETRIES=3

# ==============================================================================
# 可选项
# ==============================================================================
# HTTP proxy (if needed)
# HTTP_PROXY=http://proxy:port
# HTTPS_PROXY=http://proxy:port

# CUDA device selection
# CUDA_VISIBLE_DEVICES=0
